{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File (BDD Autowork)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "purpose": [
                "debug-in-terminal"
            ]
        }
    ]
}
